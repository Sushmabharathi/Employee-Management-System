@model EmployeeManagementSystem.Models.Employee
<h2>Edit Employee</h2>
<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div>
        <label>Name</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>

    </div>

    <div>
        <label>Department</label>
        <select asp-for="DepartmentId">
            <option value="">-- Select Department --</option>

            @foreach (var dept in ViewBag.Departments)
            {
                <option value="@dept.DepartmentId"
                        selected="@(dept.DepartmentId == Model.DepartmentId ? "selected" : null)">
                    @dept.DepartmentName
                </option>
            }
        </select>

        <span asp-validation-for="DepartmentId"></span>
    </div>

    <div>
        <label>Salary</label>
        <input asp-for="Salary" />
        <span asp-validation-for="Salary"></span>
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit">Update</button>

</form>
